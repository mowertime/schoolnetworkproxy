# Server Configuration
PORT=3000
NODE_ENV=development

# CAPTCHA Bypass Configuration (ONLY for development/testing)
# WARNING: Never enable this in production or on public-facing servers
BYPASS_CAPTCHA=true
CAPTCHA_BYPASS_TOKEN=test-bypass-token

# Security Notes:
# - BYPASS_CAPTCHA automatically enables in NODE_ENV=development
# - Use this ONLY in local testing or controlled staging environments
# - CAPTCHAs serve important security purposes in production
# - Bypassing CAPTCHAs on real websites may violate their terms of service
